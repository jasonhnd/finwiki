#!/bin/sh
# FinWiki pre-push gate. Blocks a push unless the same required verification
# pipeline used by pull requests, GitHub Pages, and Vercel passes locally.
#
#     bun run verify
#
# Install:
#     cp .githooks/pre-push .git/hooks/pre-push
# or:
#     git config core.hooksPath .githooks

cat > /dev/null

BUN=""
if [ -n "$FINWIKI_BUN" ]; then
  BUN="$FINWIKI_BUN"
elif command -v bun >/dev/null 2>&1; then
  BUN=bun
elif [ -n "$USERPROFILE" ] && [ -x "$USERPROFILE/.bun/bin/bun.exe" ]; then
  BUN="$USERPROFILE/.bun/bin/bun.exe"
elif [ -n "$HOME" ] && [ -x "$HOME/.bun/bin/bun" ]; then
  BUN="$HOME/.bun/bin/bun"
fi

if [ -z "$BUN" ]; then
  {
    echo "pre-push BLOCKED: Bun was not found for FinWiki required verification."
    echo "  Put bun on PATH or set FINWIKI_BUN=<path>."
  } >&2
  exit 1
fi

ROOT=$(git rev-parse --show-toplevel) || exit 0
cd "$ROOT" || exit 0

case "$BUN" in
  */*)
    BUN_DIR=$(dirname "$BUN")
    PATH="$BUN_DIR:$PATH"
    export PATH
    ;;
esac

echo "pre-push: running FinWiki required verification..."
"$BUN" run verify
status=$?

if [ "$status" -ne 0 ]; then
  {
    echo ""
    echo "pre-push BLOCKED (required verification exit $status)."
    echo "  Fix the reported gate, commit any synchronized files, and retry."
  } >&2
  exit 1
fi

echo "pre-push: OK - required verification passed."
exit 0
