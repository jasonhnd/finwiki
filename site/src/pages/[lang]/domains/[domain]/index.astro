---
import Base from '../../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t, u, langCodes, type Lang } from '../../../../i18n/ui';
import { domainDescription, domainName } from '../../../../i18n/domains';
import { compareEntryRoute, entryDomain, entryRoute, i18nEntryId } from '../../../../lib/routes';
import { localizedEntryPreview } from '../../../../lib/entryPreviewIndex.mjs';
import { displayLabel, readFirstEntries, readFirstLabel } from '../../../../lib/domainReadFirst';
import { localizedTitle } from '../../../../lib/siteIndex.mjs';
import { publishableTranslations } from '../../../../lib/translations';
import { buildCanonicalClusters, clustersInDomain } from '../../../../layouts/canonicalAnchors';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  const domains = [...new Set(entries.map((entry) => entryDomain(entry)))].sort();
  return langCodes.flatMap((lang) =>
    domains.map((domain) => ({
      params: { lang, domain },
      props: { lang: lang as Lang, domain },
    })),
  );
}

const { lang, domain } = Astro.props as { lang: Lang; domain: string };
const all = await getCollection('entries');
const entries = all.filter((entry) => entryDomain(entry) === domain).sort(compareEntryRoute);

const translations = publishableTranslations(await getCollection('i18n'));
const translationMap = new Map(translations.map((entry) => [entry.id, entry]));
const entryByRoute = new Map(all.map((entry) => [entryRoute(entry), entry]));

function titleFor(entry: (typeof entries)[number]): string {
  const tr = translationMap.get(i18nEntryId(lang, entry));
  return String(tr?.data?.title || localizedTitle(lang, entryRoute(entry)) || entry.data.title || entryRoute(entry));
}

function titleForRoute(route: string): string {
  const entry = entryByRoute.get(route);
  return entry ? titleFor(entry) : route;
}

function shortLead(text: string): string {
  const clean = String(text || '').trim();
  if (!clean) return '';
  const sentence = clean.match(/^[\s\S]{10,80}?[。．]/);
  if (sentence) return sentence[0];
  if (clean.length <= 64) return clean;
  const slice = clean.slice(0, 64);
  const pause = Math.max(slice.lastIndexOf('、'), slice.lastIndexOf('，'), slice.lastIndexOf(','));
  return `${(pause > 20 ? slice.slice(0, pause) : slice).replace(/[\s、，,]+$/, '')}…`;
}

const sameEntityNote =
  lang === 'ja' ? '同じ主体を別領域から読むページ。' : 'Pages that describe the same legal entity from another domain view.';

const domainClusters = clustersInDomain(buildCanonicalClusters(all), domain).map((cluster) => ({
  ...cluster,
  members: cluster.members.map((member) => ({
    ...member,
    title: displayLabel(member.route, lang, titleForRoute(member.route)),
    domainTitle: domainName(member.domain, lang),
  })),
}));

const canonicalEntries = readFirstEntries(domain, entries, titleFor);

const translatedCount = entries.filter((entry) => translationMap.has(i18nEntryId(lang, entry))).length;
const showFilter = entries.length > 24;
---
<Base lang={lang} title={domainName(domain, lang)} active="domains">
  <div class="container domain">
    <nav class="crumbs" aria-label={t(lang, 'aria.breadcrumb')}>
      <a href={u(lang, 'domains/')}>{t(lang, 'nav.domains')}</a>
      <span aria-hidden="true">/</span>
      <span>{domainName(domain, lang)}</span>
    </nav>

    <header class="domain-opener">
      <p class="eyebrow">{t(lang, 'domain.openerLabel')}</p>
      <h1>{domainName(domain, lang)}</h1>
      <p class="domain-opener__deck">{domainDescription(domain, lang)}</p>
      <div class="domain-opener__stats">
        <span><b>{entries.length.toLocaleString('en-US')}</b> {t(lang, 'domain.entries')}</span>
        {lang !== 'ja' && (
          <span><b>{translatedCount.toLocaleString('en-US')}</b> {t(lang, 'domain.translated')}</span>
        )}
      </div>
    </header>

    {canonicalEntries.length > 0 && (
      <section class="domain-brief" aria-label={t(lang, 'domain.readFirst')}>
        <h2>{t(lang, 'domain.readFirst')}</h2>
        <ol class="domain-brief__links">
          {canonicalEntries.map((entry) => {
            const route = entryRoute(entry);
            return (
              <li>
                <a href={u(lang, `${route}/`)}>
                  <span>{readFirstLabel(route, lang, titleFor(entry))}</span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    )}

    <div class="domain-list-head">
      <div>
        <p class="eyebrow">{t(lang, 'domain.routeList')}</p>
        <h2>{t(lang, 'domain.viewAll')}</h2>
      </div>
      <p class="muted">{t(lang, 'domain.routeListNote')}</p>
    </div>

    {showFilter && (
      <div class="domain__bar">
        <input id="domain-filter" type="search" class="domain__filter" placeholder={t(lang, 'browse.filter')} autocomplete="off" aria-label={t(lang, 'browse.filter')} />
        <p id="domain-empty" class="muted" hidden>{t(lang, 'browse.noMatch')}</p>
      </div>
    )}

    <ul class="domain__list">
      {entries.map((entry) => {
        const name = titleFor(entry);
        const route = entryRoute(entry);
        const lead = shortLead(localizedEntryPreview(lang, route)?.lead || '');
        const translated = lang !== 'ja' && translationMap.has(i18nEntryId(lang, entry));
        return (
          <li class="domain__item" data-name={`${name} ${route} ${lead}`.toLowerCase()}>
            <a href={u(lang, `${route}/`)} title={route}>
              <span class="domain__name">{displayLabel(route, lang, name)}</span>
              {translated && <span class="domain__tdot" title={t(lang, 'domain.translated')}></span>}
              {lead && <span class="domain__lead">{lead}</span>}
            </a>
          </li>
        );
      })}
    </ul>

    {domainClusters.length > 0 && (
      <section class="domain-same-entity" aria-labelledby="domain-same-entity-title">
        <h2 id="domain-same-entity-title">{t(lang, 'domain.canonicalAnchors')}</h2>
        <p class="domain-brief__note">{sameEntityNote}</p>
        <div class="domain-anchors">
          {domainClusters.map((cluster) => {
            const canonical = cluster.members.find((member) => member.relation === 'canonical') ?? cluster.members[0];
            const mirrors = cluster.members.filter((member) => member.route !== canonical.route);
            return (
              <div class="domain-anchor">
                <a href={u(lang, `${canonical.route}/`)}>
                  <span>{canonical.title}</span>
                  <small>{canonical.domainTitle}</small>
                </a>
                {mirrors.length > 0 && (
                  <ul>
                    {mirrors.map((member) => (
                      <li>
                        <a href={u(lang, `${member.route}/`)}>
                          <span>{member.title}</span>
                          <small>{member.domainTitle}</small>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            );
          })}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .domain {
    padding-top: var(--sp-6);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    color: var(--muted);
    font-size: var(--fs-sm);
    margin-bottom: 1.1rem;
  }
  .crumbs a {
    color: var(--accent-2);
    text-decoration: none;
  }

  .domain-opener {
    max-width: var(--measure-lead);
    margin-bottom: var(--sp-6);
  }
  .domain-opener h1 {
    margin: 0 0 0.75rem;
    font-size: var(--fs-2xl);
    line-height: 1.08;
  }
  .domain-opener__deck {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--fs-md);
    line-height: 1.55;
  }
  .domain-opener__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    align-items: center;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .domain-opener__stats b {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1;
    margin-right: 0.25rem;
  }
  .domain-opener__stats code {
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 0.12rem 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    overflow-wrap: anywhere;
  }

  .domain-brief {
    max-width: 36rem;
    margin: 0 0 var(--sp-7);
    padding: 1.15rem 0 0;
    border-top: 1px solid var(--line);
  }
  .domain-brief h2 {
    margin: 0 0 0.7rem;
    font-size: var(--fs-md);
  }
  .domain-brief__note {
    margin: 0 0 0.7rem;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .domain-brief__links {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-left: 1.35rem;
  }
  .domain-brief__links li::marker {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .domain-brief__links a,
  .domain-anchors a {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }
  .domain-brief__links a:hover,
  .domain-anchors a:hover {
    color: var(--accent-2);
  }
  .domain-brief__links span,
  .domain-anchors span {
    font-weight: 650;
    line-height: 1.4;
    overflow-wrap: normal;
    word-break: keep-all;
    line-break: strict;
  }
  html[lang="en"] .domain-brief__links span,
  html[lang="en"] .domain-anchors span {
    word-break: normal;
    line-break: auto;
  }
  .domain-brief__links small,
  .domain-anchors small {
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .domain-same-entity {
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
    max-width: 40rem;
  }
  .domain-same-entity h2 {
    margin: 0 0 0.45rem;
    font-size: var(--fs-md);
  }
  .domain-anchors {
    display: grid;
    gap: 0.85rem;
  }
  .domain-anchor {
    display: grid;
    gap: 0.35rem;
  }
  .domain-anchor ul {
    list-style: none;
    margin: 0;
    padding: 0.35rem 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.35rem;
  }

  .domain-list-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .domain-list-head h2 {
    margin: 0;
    font-size: var(--fs-lg);
  }
  .domain-list-head p {
    max-width: 34rem;
    margin: 0;
    font-size: var(--fs-sm);
  }
  .domain__bar {
    margin-bottom: 1.25rem;
  }
  .domain__filter {
    width: 100%;
    max-width: 28rem;
    min-height: 2.7rem;
    font: inherit;
    font-size: var(--fs-base);
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    background: var(--surface);
    color: var(--ink);
  }
  .domain__filter:focus-visible {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .domain__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 40rem);
    gap: 0;
  }
  .domain__item[hidden] {
    display: none;
  }
  .domain__item a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.2rem 0.5rem;
    min-width: 0;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .domain__item a:hover {
    color: var(--accent-2);
  }
  .domain__name {
    min-width: 0;
    font-weight: 550;
    overflow-wrap: normal;
    word-break: keep-all;
    line-break: strict;
  }
  html[lang="en"] .domain__name {
    word-break: normal;
    line-break: auto;
    overflow-wrap: break-word;
  }
  .domain__tdot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
    align-self: center;
  }
  .domain__lead {
    grid-column: 1 / -1;
    color: var(--browse-excerpt);
    font-size: var(--fs-sm);
    line-height: 1.6;
    overflow-wrap: normal;
    word-break: keep-all;
    line-break: strict;
  }
  html[lang="en"] .domain__lead {
    word-break: normal;
    line-break: auto;
    overflow-wrap: break-word;
  }

  @media (max-width: 560px) {
    .domain__item a {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .domain__route {
      grid-column: 1 / -1;
      text-align: left;
    }
  }
</style>

<script>
  const input = document.getElementById('domain-filter') as HTMLInputElement | null;
  if (input) {
    const empty = document.getElementById('domain-empty');
    const items = Array.from(document.querySelectorAll('.domain__item')) as HTMLElement[];
    let raf = 0;
    input.addEventListener('input', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        for (const el of items) {
          const match = !q || (el.dataset.name || '').includes(q);
          el.hidden = !match;
          if (match) visible++;
        }
        if (empty) empty.hidden = visible > 0;
      });
    });
  }
</script>
