---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t, u, langCodes, type Lang } from '../../../i18n/ui';
import { domainDescription, domainName } from '../../../i18n/domains';
import { domainGroups, groupDescription, groupName } from '../../../i18n/groups';
import { entryDomain, entryRoute, i18nEntryId } from '../../../lib/routes';
import { localizedTitle } from '../../../lib/siteIndex.mjs';
import { publishableTranslations } from '../../../lib/translations';
import { buildCanonicalClusters } from '../../../layouts/canonicalAnchors';
import { displayLabel } from '../../../lib/domainReadFirst';

export function getStaticPaths() {
  return langCodes.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };

const entries = await getCollection('entries');
const counts = new Map<string, number>();
for (const entry of entries) {
  const domain = entryDomain(entry);
  counts.set(domain, (counts.get(domain) ?? 0) + 1);
}
const note = t(lang, 'domains.note')
  .replace('{entries}', entries.length.toLocaleString('en-US'))
  .replace('{domains}', String(counts.size));

const translations = publishableTranslations(await getCollection('i18n'));
const i18nMap = new Map(translations.map((entry) => [entry.id, entry]));
const entryByRoute = new Map(entries.map((entry) => [entryRoute(entry), entry]));

function titleFor(entry: (typeof entries)[number]): string {
  const tr = i18nMap.get(i18nEntryId(lang, entry));
  return String(tr?.data?.title || localizedTitle(lang, entryRoute(entry)) || entry.data.title || entryRoute(entry));
}

const sameEntityNote =
  lang === 'ja' ? '同じ主体を別領域から読むページ。' : 'Pages that describe the same legal entity from another domain view.';

const sameEntityClusters = buildCanonicalClusters(entries).map((cluster) => ({
  ...cluster,
  members: cluster.members.map((member) => {
    const entry = entryByRoute.get(member.route);
    return {
      ...member,
      title: entry ? displayLabel(member.route, lang, titleFor(entry)) : member.route,
      domainTitle: domainName(member.domain, lang),
    };
  }),
}));
---
<Base lang={lang} title={t(lang, 'domains.title')} active="domains">
  <div class="container domains">
    <header class="domains__head">
      <p class="eyebrow">{t(lang, 'nav.domains')}</p>
      <h1>{t(lang, 'domains.title')}</h1>
      <p class="domains__deck">{t(lang, 'domains.deck')}</p>
      <p class="domains__note">{note}</p>
    </header>

    <div class="domains__groups">
      {domainGroups.map((group) => {
        const domains = group.domains.filter((domain) => counts.has(domain));
        if (!domains.length) return null;
        const total = domains.reduce((sum, domain) => sum + (counts.get(domain) ?? 0), 0);
        return (
          <section class="domain-section">
            <div class="domain-section__intro">
              <div>
                <h2>{groupName(group, lang)}</h2>
              </div>
              <span class="domain-section__count" aria-label={t(lang, 'domains.groupEntryCount')}>
                {total.toLocaleString('en-US')}
              </span>
            </div>
            <p class="domain-section__description">{groupDescription(group, lang)}</p>
            <div class="domain-section__grid">
              {domains.map((domain) => (
                <a class="domain-card" href={u(lang, `domains/${domain}/`)}>
                  <span class="domain-card__name">{domainName(domain, lang)}</span>
                  <span class="domain-card__description">{domainDescription(domain, lang)}</span>
                  <span class="domain-card__count">{(counts.get(domain) ?? 0).toLocaleString('en-US')}</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    {sameEntityClusters.length > 0 && (
      <section class="domains-anchors">
        <div class="domains-anchors__head">
          <p class="eyebrow">{t(lang, 'entry.related')}</p>
          <h2>{t(lang, 'domain.canonicalAnchors')}</h2>
          <p class="domains-anchors__note">{sameEntityNote}</p>
        </div>
        <div class="domains-anchors__grid">
          {sameEntityClusters.map((cluster) => {
            const canonical = cluster.members.find((member) => member.relation === 'canonical') ?? cluster.members[0];
            const mirrors = cluster.members.filter((member) => member.route !== canonical.route);
            return (
              <article class="domains-anchor">
                <a class="domains-anchor__canonical" href={u(lang, `${canonical.route}/`)}>
                  <span class="domains-anchor__domain">{canonical.domainTitle}</span>
                  <span class="domains-anchor__title">{canonical.title}</span>
                </a>
                <ul>
                  {mirrors.map((member) => (
                    <li>
                      <a href={u(lang, `${member.route}/`)}>
                        <span>{member.title}</span>
                        <small>{member.domainTitle}</small>
                      </a>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .domains {
    padding-top: var(--sp-7);
  }
  .domains__head {
    max-width: var(--measure-lead);
    margin-bottom: var(--sp-7);
  }
  .domains__head h1 {
    margin: 0 0 0.65rem;
    font-size: var(--fs-2xl);
    line-height: 1.1;
  }
  .domains__deck {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--fs-md);
    line-height: 1.55;
  }
  .domains__note {
    margin: 1rem 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .domains__groups {
    display: flex;
    flex-direction: column;
    gap: var(--gap-section);
  }

  .domain-section {
    min-width: 0;
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
  }
  .domain-section__intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.55rem;
  }
  .domain-section__intro .eyebrow {
    margin-bottom: 0.35rem;
  }
  .domain-section__intro h2 {
    margin: 0;
    font-size: var(--fs-lg);
  }
  .domain-section__count {
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 0.16rem 0.65rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }
  .domain-section__description {
    max-width: var(--measure-lead);
    margin: 0 0 1.15rem;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
  .domain-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .domain-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.35rem 0.8rem;
    min-width: 0;
    min-height: 8rem;
    padding: 1rem;
    background: var(--paper);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .domain-card:hover {
    background: var(--surface);
  }
  .domain-card__name {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    line-height: 1.35;
    overflow-wrap: normal;
    word-break: keep-all;
    line-break: strict;
  }
  html[lang="en"] .domain-card__name {
    word-break: normal;
    line-break: auto;
    overflow-wrap: break-word;
  }
  .domain-card__description {
    grid-column: 1 / -1;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: 1.6;
    overflow-wrap: normal;
    word-break: keep-all;
    line-break: strict;
  }
  html[lang="en"] .domain-card__description {
    word-break: normal;
    line-break: auto;
    overflow-wrap: break-word;
  }
  .domain-card__count {
    justify-self: start;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 0.1rem 0.55rem;
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    line-height: 1.6;
  }

  .domains-anchors {
    margin-top: var(--gap-section);
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .domains-anchors__head {
    max-width: var(--measure-lead);
    margin-bottom: 1.15rem;
  }
  .domains-anchors__head h2 {
    margin: 0;
    font-size: var(--fs-lg);
  }
  .domains-anchors__note {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .domains-anchors__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .domains-anchor {
    min-width: 0;
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
    background: var(--paper);
  }
  .domains-anchor__canonical,
  .domains-anchor ul a {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }
  .domains-anchor__canonical:hover .domains-anchor__title,
  .domains-anchor ul a:hover {
    color: var(--accent-2);
  }
  .domains-anchor__domain {
    color: var(--accent);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .domains-anchor__title,
  .domains-anchor ul span {
    font-weight: 650;
    line-height: 1.4;
    overflow-wrap: normal;
    word-break: keep-all;
    line-break: strict;
  }
  html[lang="en"] .domains-anchor__title,
  html[lang="en"] .domains-anchor ul span {
    word-break: normal;
    line-break: auto;
    overflow-wrap: break-word;
  }
  .domains-anchor ul {
    list-style: none;
    margin: 0;
    padding: 0.55rem 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.4rem;
  }
  .domains-anchor small {
    color: var(--muted);
    font-size: var(--fs-xs);
  }

  @media (max-width: 560px) {
    .domain-section__intro {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
